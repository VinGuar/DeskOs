# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Only developer and build-time settings go here. Keys DeskOS stores for a
# user at runtime (connector tokens) live in the OS keychain, never in a file.

# Used by `pnpm eval` (M5) for real model calls. Not needed for `pnpm check`.
ANTHROPIC_API_KEY=
